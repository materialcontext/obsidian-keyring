{
	"name": "obsidian-keyring",
	"version": "0.1.0",
	"description": "Hover {{term}} marks to see every section in your vault with a matching heading.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "esbuild bench/core.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/keyring-bench/core.cjs && node node_modules/.cache/keyring-bench/core.cjs",
		"bench:memory": "esbuild bench/memory.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/keyring-bench/memory.cjs && node --expose-gc node_modules/.cache/keyring-bench/memory.cjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "6.12.4",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@lezer/common": "1.5.3",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"prettier": "^3.9.9",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	}
}
